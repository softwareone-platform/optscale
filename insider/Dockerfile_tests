ARG BUILDTAG=build
ARG IMAGE=insider_api
FROM ${IMAGE}:${BUILDTAG}
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
LABEL org.opencontainers.image.authors="Hystax"

COPY tools tools
COPY optscale_client/insider_client optscale_client/insider_client

COPY insider/.pylintrc insider/.coveragerc ./insider/
COPY insider/${IMAGE}/pyproject.toml insider/${IMAGE}/uv.lock ./insider/${IMAGE}/

RUN uv --project insider/${IMAGE} sync --locked

COPY insider/${IMAGE}/tests insider/${IMAGE}/tests
