# Regression-test environment variables.
# See utils/env.ts for the full contract; every variable below is the only
# form this project reads. Unset values fall back to safe defaults.

# ─── App under test ───────────────────────────────────────────────────────
# Environment preset, defined in utils/env.ts: prerelease | dev | local.
# Selects the base + API URLs. Default: local.
#   TEST_ENV=dev npx playwright test
TEST_ENV=local

# Optional overrides for the preset's URLs (CI or ad-hoc runs). Leave unset to
# use the preset. Examples:
#   http://localhost:3000          (local dev)
#   https://portal.finops.s1.today (shared dev)
BASE_URL_OVERRIDE=
API_BASE_URL_OVERRIDE=

# Test-account bearer token, sent in the `X-LiveDemo-Token` header for
# `POST /restapi/v2/live_demo`. Required only when regenerating the cached
# session (every ~6 days).
# The per-env var matching TEST_ENV is used automatically; TEST_ACCOUNT_TOKEN
# is the fallback (e.g. a single token injected in CI).
PRERELEASE_TEST_ACCOUNT_TOKEN=
DEV_TEST_ACCOUNT_TOKEN=
LOCAL_TEST_ACCOUNT_TOKEN=
TEST_ACCOUNT_TOKEN=

# ─── Run modes ────────────────────────────────────────────────────────────
# Where screenshot snapshots live: baseline | local (default: local).
#   baseline → committed snapshots/baseline/<host>/ (shared; CI uses this)
#   local    → gitignored snapshots/local/<host>/<platform>/ (per developer)
SNAPSHOT_MODE=local

# Accept self-signed / expired certs (useful when the base URL is an internal host).
IGNORE_HTTPS_ERRORS=false

# ─── Debug hooks ──────────────────────────────────────────────────────────
# Emit [DEBUG]-prefixed Node-side logs from `debugLog`.
DEBUG_LOG=false

# Forward browser `console.error` output to the Node test runner.
BROWSER_ERROR_LOGGING=false
