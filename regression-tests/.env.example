# Regression-test environment variables.
# See utils/env.ts for the full contract; every variable below is the only
# form this project reads. Unset values fall back to safe defaults.

# ─── App under test ───────────────────────────────────────────────────────
# Environment preset. The full definition of each one (portal URL, API URL,
# token variable) lives in env.config.ts:
#   local      → localhost:3000                 + api.finops.s1.today
#   dev        → portal.finops.s1.today         + api.finops.s1.today
#   prerelease → portal.finops.s1.show          + api.finops.s1.show
#   staging    → portal.finops.s1.live          + api.finops.s1.live
#   prod       → portal.finops.softwareone.com  + api.finops.softwareone.com
# Default: local.
#   TEST_ENV=prerelease npx playwright test
TEST_ENV=local

# Optional overrides for the preset's URLs (CI or ad-hoc runs). Leave unset to
# use the preset. These change where the run points, NOT which token or
# baseline folder it uses — those follow TEST_ENV.
BASE_URL_OVERRIDE=
API_BASE_URL_OVERRIDE=

# Test-account bearer tokens, sent in the `X-LiveDemo-Token` header for
# `POST /restapi/v2/live_demo`. Needed only when regenerating the cached
# session (every ~6 days).
# Each environment reads its own variable — there is no shared fallback, so a
# run fails fast rather than authenticating against the wrong deployment.
# `local` and `dev` share the _DEV token: same deployment, same account.
TEST_ACCOUNT_TOKEN_DEV=
TEST_ACCOUNT_TOKEN_PRERELEASE=
TEST_ACCOUNT_TOKEN_STAGING=
TEST_ACCOUNT_TOKEN_PROD=

# ─── Run modes ────────────────────────────────────────────────────────────
# Compare against another environment's screenshots: dev | prerelease | staging | prod.
# Defaults to the environment under test. Moves only the screenshots — the token and
# cached session stay with TEST_ENV. Prefer passing it per run rather than setting it here:
#   TEST_ENV=prerelease SNAPSHOT_ENV=dev npm test
#   ./run_pw.sh -E prerelease -S dev
# Screenshots live at snapshots/<env>/<renderer>/, where <renderer> is 'docker' for
# container runs (committed, shared) or your platform for local runs (gitignored).
SNAPSHOT_ENV=

# Playwright workers in CI (default: 2). Local runs ignore this and use half the
# machine's cores capped at 3 — see the `workers` note in playwright.config.ts.
PW_WORKERS=

# Accept self-signed / expired certs (useful when the base URL is an internal host).
IGNORE_HTTPS_ERRORS=false

# ─── Debug hooks ──────────────────────────────────────────────────────────
# Emit [DEBUG]-prefixed Node-side logs from `debugLog`.
DEBUG_LOG=false

# Forward browser `console.error` output to the Node test runner.
BROWSER_ERROR_LOGGING=false
