{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./auth/**)",
      "Read(./bi_exporter/**)",
      "Read(./bulldozer/**)",
      "Read(./bumischeduler/**)",
      "Read(./bumiworker/**)",
      "Read(./diproxy/**)",
      "Read(./diworker/**)",
      "Read(./docker_images/**)",
      "Read(./gemini/**)",
      "Read(./herald/**)",
      "Read(./insider/**)",
      "Read(./jira_bus/**)",
      "Read(./jira_ui/**)",
      "Read(./katara/**)",
      "Read(./keeper/**)",
      "Read(./metroculus/**)",
      "Read(./ovr/**)",
      "Read(./risp/**)",
      "Read(./slacker/**)",
      "Read(./subspector/**)",
      "Read(./trapper/**)",
      "Read(**/node_modules/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.cer)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)"
    ]
  }
}
